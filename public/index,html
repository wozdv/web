<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NEON STORE</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header><h1>NEON<span>STORE</span></h1><p>Tienda oficial del servidor</p></header>

  <main>
    <section class="nick-box">
      <label for="nick">1. Tu nick en el juego</label>
      <input id="nick" maxlength="16" placeholder="Ej: Steve_123" autocomplete="off">
      <small id="nick-help">3-16 caracteres: letras, números y _</small>
    </section>

    <section>
      <h2>2. Elige tu producto</h2>
      <div id="products" class="grid"></div>
    </section>

    <section id="checkout" hidden>
      <h2>3. Paga</h2>
      <p id="summary"></p>
      <div id="paypal-buttons"></div>
    </section>

    <p id="status" role="status"></p>
  </main>

  <script src="app.js"></script>
</body>
</html>
